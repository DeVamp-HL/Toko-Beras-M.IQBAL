// ============================================================================
// ATURAN FIRESTORE v3 — Toko Beras M.IQBAL (putaran 23, 24 Sep 2026): AKUN PER ORANG
// Berkas KANONIK ber-versi. DEPLOY: salin-tempel ke Console > Firestore > Rules.
// Dasar tiap baris: docs/peta-hak-akses.md. Rules yang tidak bisa ditelusuri ke satu baris peta = cacat.
// Diperiksa statis oleh alat-uji/periksa_rules.py (CI). Uji server: docs/uji-rules-v3.md.
// Jalan mundur: firestore.rules.v2 (disimpan utuh).
//
// AKUN & PERAN — penegakan di SERVER, bukan di layar:
//   owner@tokoberasmiqbal.web.app  -> OWNER, dikenali lewat EMAIL (sama dengan v2). Tidak pernah lewat dokumen apa pun,
//                                     jadi owner tidak mungkin terkunci karena aksesAkun rusak, dan tidak ada yang naik pangkat lewat satu dokumen.
//   kasir@tokoberasmiqbal.web.app  -> KASIR DARURAT: hak v2 persis (create penjualan / piutangMutasi / stokBahanLiteran / logAktivitas,
//                                     tulis-ulang-sama, denyut perangkatStatus, baca ringkasanKasir & pengaturan/aksesKasir).
//                                     v2 memberi jalur itu ke SIAPA PUN yang login (masuk()); v3 MEMPERSEMPITNYA ke email kasir@ (keputusan owner 24 Sep).
//   akun lain                      -> peran dari aksesAkun/{uid} yang ditulis OWNER: { uid, nama, email, peran: 'ben'|'karyawan', aktif: bool }.
//                                     Tanpa aksesAkun aktif = NOL akses (kecuali create permintaanAkses miliknya) — tetap aman seandainya
//                                     pendaftaran mandiri dibuka lagi. Tiap tulisan wajib olehUid = uid penulis (jujur()).
//                                     Putaran ini: bukan-owner hanya CREATE (+2 update terbatas kolom, peta §5), tidak pernah DELETE.
//   UTANG: id peran 'ben' memakai nama orang — peran harus bernama jabatan (dicatat owner 24 Sep; data SS2 bergantung padanya).
//
// MENAMBAH PERAN (mis. 'kasir'): tambahkan satu nama di daftar peran tiap koleksi yang boleh untuk peran itu (baris staf(...) /
//   stafBuat(...) di bawah) DAN di baru/js/data/akses.js (BACA_STAF, BUAT_STAF, UBAH_STAF) — periksa_rules.py memastikan keduanya sama.
//   Izinkan juga di aksesAkun (peran in [...]). Tidak perlu menulis ulang rules.
//
// ACCESS CALL: tiap tulisan bukan-owner memeriksa aksesAkun SEKALI (1 get()); owner() di depan = owner tidak memicu get().
//   Batas Firebase: 10 per permintaan dokumen tunggal / tiap operasi, 20 per batch/transaksi — cache TIDAK diandalkan.
//   Kiriman bukan-owner terbesar yang mungkin: 19 dokumen + 1 jejak = 20 (pagar di penulis pusat). Nota nyata terpanjang: 9 / 20.
//   Kiriman terbesar BELUM DIUJI DI SERVER — lihat gerbang di bawah.
//
// URUTAN PASANG (anti terkunci; keputusan owner 24 Sep — DIBALIK dari prompt):
//   0. Prasyarat: pendaftaran mandiri MATI (Console > Authentication > Settings > User actions) & daftar Users diperiksa.
//   1. GERBANG: uji v3 di PROYEK FIREBASE KEDUA (khusus uji, data toko asli tidak disentuh) — docs/uji-rules-v3.md.
//   2. Tempel rules v3 ini ke Console proyek toko.
//   3. Buat SATU nota dari kasir darurat (kasir@) dan pastikan nota itu masuk (jalur kasir tidak ikut tertutup).
//   4. Buat akun orang di Console > Authentication > Add user (klien tidak pernah membuat akun).
//   5. Orangnya masuk /baru/ → "Minta didaftarkan"; owner menyetujui di Menu > Sistem > Peran (tidak ada UID disalin tangan).
//   MUNDUR = tempel firestore.rules.v2 — HANYA selama pendaftaran mandiri mati (v2 membuka jalur kasir untuk siapa pun yang login).
// ============================================================================
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function masuk() { return request.auth != null; }
    function owner() {
      return masuk() && request.auth.token.email == 'owner@tokoberasmiqbal.web.app';
    }
    function kasir() {
      return masuk() && request.auth.token.email == 'kasir@tokoberasmiqbal.web.app';
    }
    // KIRIM-ULANG ANTREAN KASIR WAJIB IDEMPOTEN (v2, dipertahankan untuk kasir@): update hanya kalau isinya SAMA PERSIS.
    function tulisUlangSama() {
      return request.resource.data == resource.data;
    }

    // ---- akun bukan-owner (aksesAkun/{uid}) — SATU get() per evaluasi ----
    function akun() { return get(/databases/$(database)/documents/aksesAkun/$(request.auth.uid)).data; }
    function aktifDengan(a, peranBoleh) { return a.aktif == true && a.peran in peranBoleh; }
    function jujur() { return request.resource.data.olehUid == request.auth.uid; }
    function staf(peranBoleh) { return masuk() && aktifDengan(akun(), peranBoleh); }
    function stafBuat(peranBoleh) { return masuk() && aktifDengan(akun(), peranBoleh) && jujur(); }
    function stafBuatTipe(peranBoleh, tipe) { return stafBuat(peranBoleh) && request.resource.data.tipe == tipe; }
    function stafBuatJual(peranBoleh, peranKredit) {
      let a = akun();
      let d = request.resource.data;
      return masuk() && aktifDengan(a, peranBoleh) && jujur()
        && !d.keys().hasAny(['dibatalkan', 'dikoreksiOleh', 'dikoreksiPada', 'dibatalkanPada', 'namaDihapus'])
        && (string(d.get('caraBayar', '')).lower() != 'kredit' || a.peran in peranKredit);
    }
    function stafJejak(peranBoleh) {
      let d = request.resource.data;
      return stafBuat(peranBoleh) && d.dokumen is list && d.dokumen.size() >= 1 && d.dokumen.size() <= 19;
    }
    // peta §5 baris 1: pesanan yang belum tuntas jadi 'dibayar' — kolom dibatasi, uang/berat tidak tersentuh
    function stafUbahPesanan(peranBoleh) {
      return masuk() && aktifDengan(akun(), peranBoleh) && request.resource.data.diubahOlehUid == request.auth.uid
        && !(resource.data.get('status', '') in ['dibayar', 'batal']) && request.resource.data.status == 'dibayar'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'riwayatStatus', 'trxIdJual', 'diubahOleh', 'diubahOlehUid', 'diubahPerangkat', 'diubahPada']);
    }
    // peta §5 baris 2: denyut perangkat — dokumen perangkatnya sendiri, kolom denyut saja
    function stafDenyut(peranBoleh) {
      return masuk() && aktifDengan(akun(), peranBoleh) && request.resource.data.akunUid == request.auth.uid
        && (resource == null || resource.data.get('akunUid', request.auth.uid) == request.auth.uid)
        && request.resource.data.keys().hasOnly(['id', 'nama', 'akun', 'akunUid', 'aplikasi', 'pada', 'antrean', 'gagal', 'versi', 'pemegang', 'lokasi']);
    }

    // ---- satu blok per koleksi di baru/js/data/koleksi.js (+ arsipTahun, ringkasanKasir). Bukan-owner TIDAK bergantung pada payung. ----
    match /batchMasuk/{id} {
      allow read: if owner() || staf(['ben', 'karyawan']);
      allow write: if owner();
    }

    match /biayaBulanan/{id} {
      allow read, write: if owner();
    }

    match /penjualan/{id} {
      allow read: if owner() || staf(['ben', 'karyawan']);
      allow create: if owner() || kasir() || stafBuatJual(['ben', 'karyawan'], ['ben']);   // Kredit (jualBon): ben saja
      allow update: if owner() || (kasir() && tulisUlangSama());
      allow delete: if owner();
    }

    match /produksiKemasan/{id} {
      allow read: if owner() || staf(['ben', 'karyawan']);
      allow create: if owner() || stafBuat(['ben', 'karyawan']);   // adukan
      allow update, delete: if owner();
    }

    match /retur/{id} {
      allow read: if owner() || staf(['ben', 'karyawan']);
      allow write: if owner();
    }

    match /karantina/{id} {
      allow read: if owner() || staf(['ben', 'karyawan']);
      allow write: if owner();
    }

    match /pengeluaranHarian/{id} {
      allow read, write: if owner();
    }

    match /stokBahanKemasan/{id} {
      allow read: if owner() || staf(['ben', 'karyawan']);
      allow create: if owner() || stafBuatTipe(['ben', 'karyawan'], 'pakai');   // bukan beli
      allow update, delete: if owner();
    }

    match /stokBahanLiteran/{id} {
      allow read: if owner() || staf(['ben', 'karyawan']);
      allow create: if owner() || kasir() || stafBuatTipe(['ben', 'karyawan'], 'pakai');   // bukan beli
      allow update: if owner() || (kasir() && tulisUlangSama());
      allow delete: if owner();
    }

    match /katalogHargaLiteran/{id} {
      allow read: if owner() || staf(['ben', 'karyawan']);
      allow write: if owner();
    }

    match /katalogHargaKemasan/{id} {
      allow read: if owner() || staf(['ben', 'karyawan']);
      allow write: if owner();
    }

    match /katalogHargaKarung/{id} {
      allow read: if owner() || staf(['ben', 'karyawan']);
      allow write: if owner();
    }

    match /piutangMutasi/{id} {
      allow read: if owner() || staf(['ben', 'karyawan']);
      allow create: if owner() || kasir() || stafBuatTipe(['ben', 'karyawan'], 'bayar');   // bukan hapusBuku / saldoAwal
      allow update: if owner() || (kasir() && tulisUlangSama());
      allow delete: if owner();
    }

    match /kasbonMutasi/{id} {
      allow read, write: if owner();
    }

    match /penyesuaianStok/{id} {
      allow read: if owner() || staf(['ben', 'karyawan']);
      allow write: if owner();
    }

    match /tutupHari/{id} {
      allow read, write: if owner();
    }

    match /pelangganCatatan/{id} {
      allow read: if owner() || staf(['ben', 'karyawan']);
      allow create: if owner() || stafBuat(['ben', 'karyawan']);   // pelanggan baru; kartu yang sudah ada = update = owner
      allow update, delete: if owner();
    }

    match /pesanan/{id} {
      allow read: if owner() || staf(['ben', 'karyawan']);
      allow create: if owner();
      allow update: if owner() || stafUbahPesanan(['ben', 'karyawan']);   // peta §5 baris 1: jadi dibayar
      allow delete: if owner();
    }

    match /titipanHarian/{id} {
      allow read, write: if owner();
    }

    match /setoranKas/{id} {
      allow read, write: if owner();
    }

    match /penyesuaianKemasan/{id} {
      allow read: if owner() || staf(['ben', 'karyawan']);
      allow write: if owner();
    }

    match /amplopLaba/{id} {
      allow read, write: if owner();
    }

    match /modalOwner/{id} {
      allow read, write: if owner();
    }

    match /utangOwnerMutasi/{id} {
      allow read, write: if owner();
    }

    match /tembusanStok/{id} {
      allow read, write: if owner();
    }

    match /utangPemasokMutasi/{id} {
      allow read, write: if owner();
    }

    match /thrPelanggan/{id} {
      allow read, write: if owner();
    }

    match /pemasokCatatan/{id} {
      allow read, write: if owner();
    }

    match /wadahLiteran/{id} {
      allow read: if owner() || staf(['ben', 'karyawan']);
      allow write: if owner();
    }

    match /aturanToko/{id} {
      allow read: if owner() || (id in ['struk', 'pelanggan', 'pelangganKembar', 'catatStok', 'kantong', 'tempat', 'peran', 'perangkat'] && staf(['ben', 'karyawan']));   // per dokumen (peta §3)
      allow write: if owner();
    }

    match /bukuHapus/{id} {
      allow read, write: if owner();
    }

    match /tagihPelanggan/{id} {
      allow read: if owner() || staf(['ben', 'karyawan']);
      allow write: if owner();
    }

    match /pelangganTitip/{id} {
      allow read: if owner() || staf(['ben', 'karyawan']);
      allow write: if owner();
    }

    match /perangkatStatus/{id} {
      allow read: if owner();
      allow create, update: if owner() || kasir() || stafDenyut(['ben', 'karyawan']);   // peta §5 baris 2
      allow delete: if owner();
    }

    match /logAktivitas/{id} {
      allow read: if owner();
      allow create: if owner() || kasir() || stafJejak(['ben', 'karyawan']);   // bukan-owner: SATU baris per kiriman berisi daftar dokumen
      allow update, delete: if owner();
    }

    match /cadanganCatatan/{id} {
      allow read, write: if owner();
    }

    match /pengingat/{id} {
      allow read, write: if owner();
    }

    match /persetujuan/{id} {
      allow read, write: if owner();
    }

    match /pindahStok/{id} {
      allow read, write: if owner();
    }

    match /hargaWadah/{id} {
      allow read: if owner() || staf(['ben', 'karyawan']);
      allow write: if owner();
    }

    match /strukKeluar/{id} {
      allow read: if owner() || staf(['ben', 'karyawan']);
      allow create: if owner() || stafBuat(['ben', 'karyawan']);
      allow update, delete: if owner();
    }

    match /pengaturan/{id} {
      allow read: if owner() || (id == 'tempatSimpan' && staf(['ben', 'karyawan'])) || (id == 'aksesKasir' && kasir());   // titikKas & keamanan: owner saja
      allow write: if owner();
    }

    match /pindahTempat/{id} {
      allow read: if owner() || staf(['ben', 'karyawan']);
      allow write: if owner();
    }

    match /koreksiHpp/{id} {
      allow read, write: if owner();
    }

    match /hargaPasar/{id} {
      allow read, write: if owner();
    }

    match /hargaTerbit/{id} {
      allow read, write: if owner();
    }

    match /pesananPemasok/{id} {
      allow read, write: if owner();
    }

    match /pindahUang/{id} {
      allow read, write: if owner();
    }

    match /absenKaryawan/{id} {
      allow read, write: if owner();
    }

    match /slipUpah/{id} {
      allow read, write: if owner();
    }

    match /tutupBukuAcara/{id} {
      allow read, write: if owner();
    }

    match /dokumenCetak/{id} {
      allow read, write: if owner();
    }

    match /aksesAkun/{uid} {
      allow read: if owner() || (masuk() && request.auth.uid == uid);
      allow create, update: if owner() && request.resource.data.uid == uid && request.resource.data.peran in ['ben', 'karyawan'] && request.resource.data.aktif is bool;   // tak pernah owner
      allow delete: if owner();
    }

    match /permintaanAkses/{uid} {
      allow create: if masuk() && request.auth.uid == uid && !owner() && !kasir()
        && !exists(/databases/$(database)/documents/aksesAkun/$(uid))
        && request.resource.data.keys().hasOnly(['uid', 'email', 'nama', 'pada']) && request.resource.data.uid == uid
        && request.resource.data.email == string(request.auth.token.email).lower()
        && request.resource.data.nama is string && request.resource.data.nama.size() >= 2 && request.resource.data.nama.size() <= 40;
      allow read, delete: if owner();
    }

    match /arsipTahun/{id} {
      allow read, write: if owner();   // arsip tutup buku: owner saja
    }

    match /ringkasanKasir/{id} {
      allow read: if owner() || kasir();
      allow write: if owner();
    }

    // Payung: segalanya yang tidak disebut di atas — termasuk pengaturan/keamanan (PIN) & koleksi lama sistem lama — owner saja.
    match /{document=**} {
      allow read, write: if owner();
    }
  }
}
